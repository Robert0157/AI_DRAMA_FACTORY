{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.auto_drama/schemas/music_drama_draft_v2.schema.json",
  "title": "MusicDramaDraft v2 (Music-First MV)",
  "description": "CEO-approved draft schema for music-driven MV episodes (song = only master track, zero dialogue). Consumed by Auto_Drama `run.py music-drama`; validated strictly in auto_drama/music_drama.py (this schema is editor guidance + contract reference).",
  "type": "object",
  "required": ["schema_version", "world", "episode", "audio", "visual_style", "cast", "scenes", "shots", "audio_policy"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "music_drama.v2" },
    "world": { "enum": ["lofi", "light_music"] },
    "series": { "type": "string" },
    "episode": {
      "type": "object",
      "required": ["title", "zero_dialogue"],
      "properties": {
        "episode_id": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "language": { "enum": ["zh", "en"] },
        "zero_dialogue": { "const": true }
      }
    },
    "audio": {
      "type": "object",
      "required": ["file", "sha256", "segment"],
      "properties": {
        "file": { "type": "string", "description": "Workspace-relative path to the CEO-approved MP3." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "File fingerprint pinned at drafting time; ingestion re-verifies." },
        "duration_sec": { "type": "number" },
        "segment": {
          "type": "object",
          "required": ["start_sec", "end_sec"],
          "properties": {
            "start_sec": { "type": "number", "minimum": 0 },
            "end_sec": { "type": "number", "minimum": 4 }
          }
        },
        "has_vocals": { "type": "boolean" },
        "bpm": { "type": "number" },
        "style_family": { "type": "string" },
        "style_pillar": { "type": "string" }
      }
    },
    "visual_style": {
      "type": "object",
      "required": ["aspect_ratio"],
      "properties": {
        "genres": { "type": "array", "items": { "type": "string" } },
        "palette": { "type": "string" },
        "aspect_ratio": { "enum": ["9:16", "16:9"] },
        "resolution": { "enum": ["480p", "720p", "1080p"], "default": "480p",
          "description": "CEO cost policy 2026-09-10: initial runs use 480p; higher resolutions require CEO approval." },
        "style_prefix": { "type": "string", "description": "Prepended to every shot's universal segment text." }
      }
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "name", "portrait_prompt"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "appearance": { "type": "string" },
          "description": { "type": "string" },
          "portrait_prompt": { "type": "string", "description": "Single clean portrait prompt (Zhipu CogView, 3:4) -> LMD character ref image." }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "location"],
        "properties": {
          "scene_id": { "type": "integer", "minimum": 1 },
          "location": { "type": "string" },
          "time": { "type": "string" },
          "atmosphere": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_number", "start_sec", "end_sec", "duration_sec", "title", "action", "characters", "universal_segment_text"],
        "properties": {
          "shot_number": { "type": "integer", "minimum": 1 },
          "scene_id": { "type": "integer" },
          "start_sec": { "type": "number", "minimum": 0 },
          "end_sec": { "type": "number" },
          "duration_sec": { "type": "number", "minimum": 4, "maximum": 30, "description": "Seedance 2.5 window is 4-30s (CEO-authorized long-take mode, 2026-09-10); other 2.x models cap at 15s." },
          "music_section": { "type": "string" },
          "audio_cue": { "type": "string", "description": "Lyric/section sync cue driving the visual beats." },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "action": { "type": "string" },
          "shot_type": { "type": "string" },
          "camera": { "type": "string" },
          "lighting": { "type": "string" },
          "expression": { "type": "string" },
          "characters": { "type": "array", "items": { "type": "string" }, "description": "cast[].key references." },
          "image_prompt": { "type": "string" },
          "universal_segment_text": { "type": "string", "description": "CN LMD universal prompt with @图片N slots (<= bound refs)." }
        }
      }
    },
    "audio_policy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "const": "music_master" },
        "seedance_audio": { "enum": ["ambient_only", "discard"] },
        "ambient_gain_db": { "type": "number", "description": "Gain applied to Seedance track (default -27 dB)." },
        "target_lufs": { "type": "number" }
      }
    }
  }
}
