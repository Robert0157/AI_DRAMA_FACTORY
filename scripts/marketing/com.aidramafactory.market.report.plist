<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aidramafactory.market.report</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/AI_Workspace/AI_Drama_Factory/.venv/bin/python3</string>
        <string>/Volumes/AI_Workspace/AI_Drama_Factory/scripts/marketing/market_validation_report.py</string>
        <string>--notify</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Volumes/AI_Workspace/AI_Drama_Factory</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>AI_DRAMA_REPO_ROOT</key>
        <string>/Volumes/AI_Workspace/AI_Drama_Factory</string>
        <key>HOME</key>
        <string>/Users/robert</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TZ</key>
        <string>Asia/Taipei</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/robert/Library/Logs/AI_Drama_Factory/market_report.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/robert/Library/Logs/AI_Drama_Factory/market_report.err.log</string>
</dict>
</plist>
